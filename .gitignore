# Design material is deliberately kept out of git and carried between machines
# by hand. GitHub holds code only. See CLAUDE.md.
docs/*
!docs/.gitkeep

# Research sources live in an external service.
Research/*
!Research/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.coverage

# Frontend. Source is tracked; the build is not -- it is generated, large, and
# would make every UI commit unreviewable.
ui/node_modules/
ui/dist/
.vite/
*.tsbuildinfo
